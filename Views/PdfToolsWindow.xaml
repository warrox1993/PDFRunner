<Window x:Class="ConvertPDF.Views.PdfToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:ConvertPDF.ViewModels"
        xmlns:converters="clr-namespace:ConvertPDF.Converters"
        Title="PDF Tools" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="PDF Tools" FontSize="24" FontWeight="Bold" 
                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,20"/>

        <!-- Step 1: Select PDF -->
        <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="1. Sélectionnez un fichier PDF" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0" Text="{Binding SelectedFilePath}" IsReadOnly="True" 
                             Margin="0,0,10,0" materialDesign:HintAssist.Hint="Aucun fichier sélectionné"/>
                    <Button Grid.Column="1" Command="{Binding BrowseFileCommand}" 
                            Content="Parcourir..." Style="{DynamicResource MaterialDesignOutlinedButton}"/>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,5,0,0" FontSize="11" Opacity="0.7"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Step 2 & 3: Select Operation and Configure -->
        <materialDesign:Card Grid.Row="2" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="2. Choisissez une opération" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    
                    <StackPanel>
                        <RadioButton Content="Diviser (1 fichier par page)" IsChecked="True"
                                     GroupName="Operation" Margin="0,0,0,8"
                                     Checked="Operation_Checked" Tag="0"/>
                        <RadioButton Content="Extraire des pages (plage spécifique)" 
                                     GroupName="Operation" Margin="0,0,0,8"
                                     Checked="Operation_Checked" Tag="1"/>
                        <RadioButton Content="Pivoter une page" 
                                     GroupName="Operation" Margin="0,0,0,8"
                                     Checked="Operation_Checked" Tag="2"/>
                        <RadioButton Content="Supprimer des pages" 
                                     GroupName="Operation" Margin="0,0,0,8"
                                     Checked="Operation_Checked" Tag="3"/>
                        <RadioButton Content="Fusionner plusieurs PDF" 
                                     GroupName="Operation" Margin="0,0,0,8"
                                     Checked="Operation_Checked" Tag="4"/>
                    </StackPanel>

                    <Separator Margin="0,15"/>

                    <TextBlock Text="3. Configuration" FontWeight="SemiBold" Margin="0,15,0,10"/>

                    <!-- Split Panel -->
                    <StackPanel x:Name="SplitPanel" Visibility="Visible">
                        <TextBlock Text="Le dossier de sortie sera demandé lors de l'exécution." 
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                    </StackPanel>

                    <!-- Extract Panel -->
                    <StackPanel x:Name="ExtractPanel" Visibility="Collapsed">
                        <TextBox Text="{Binding PageRange}" 
                                 materialDesign:HintAssist.Hint="Plage de pages (ex: 1-3, 5, 7-9)"/>
                    </StackPanel>

                    <!-- Rotate Panel -->
                    <StackPanel x:Name="RotatePanel" Visibility="Collapsed">
                        <ComboBox SelectedIndex="0" Margin="0,0,0,10"
                                  SelectionChanged="PageSelector_SelectionChanged"
                                  materialDesign:HintAssist.Hint="Page à pivoter">
                        </ComboBox>
                        <ComboBox x:Name="RotationComboBox" SelectedIndex="0"
                                  SelectionChanged="Rotation_SelectionChanged">
                            <ComboBoxItem Content="90° droite"/>
                            <ComboBoxItem Content="180°"/>
                            <ComboBoxItem Content="270° gauche"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Delete Panel -->
                    <StackPanel x:Name="DeletePanel" Visibility="Collapsed">
                        <TextBox Text="{Binding PageRange}" 
                                 materialDesign:HintAssist.Hint="Pages à supprimer (ex: 2, 4-6)"/>
                    </StackPanel>

                    <!-- Merge Panel -->
                    <StackPanel x:Name="MergePanel" Visibility="Collapsed">
                        <TextBlock Text="Sélectionnez les PDF à fusionner dans l'ordre :" FontSize="12" Margin="0,0,0,8" Opacity="0.7"/>
                        <ListBox ItemsSource="{Binding MergeFiles}" Height="120" Margin="0,0,0,8" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{DynamicResource MaterialDesignIconButton}" Width="24" Height="24"
                                                    Command="{Binding DataContext.MoveMergeFileUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Foreground="{DynamicResource MaterialDesignBodySecondary}">
                                                <materialDesign:PackIcon Kind="ArrowUp" Width="14" Height="14"/>
                                            </Button>
                                            <Button Style="{DynamicResource MaterialDesignIconButton}" Width="24" Height="24"
                                                    Command="{Binding DataContext.MoveMergeFileDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Foreground="{DynamicResource MaterialDesignBodySecondary}">
                                                <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14"/>
                                            </Button>
                                            <Button Style="{DynamicResource MaterialDesignIconButton}" Width="24" Height="24"
                                                    Command="{Binding DataContext.RemoveMergeFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="Red"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="+ Ajouter des fichiers" Command="{Binding AddMergeFileCommand}" 
                                Style="{DynamicResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Padding="8,2"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- Action Buttons -->
        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Annuler" Click="Cancel_Click"
                    Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Exécuter" Command="{Binding ExecuteCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Style="{DynamicResource MaterialDesignRaisedButton}"/>
        </Grid>
    </Grid>
</Window>
