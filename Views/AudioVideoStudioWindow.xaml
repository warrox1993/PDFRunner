<Window x:Class="ConvertPDF.Views.AudioVideoStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ConvertPDF.ViewModels"
        xmlns:converters="clr-namespace:ConvertPDF.Converters"
        mc:Ignorable="d"
        Title="ConvertPDF Studio - Transcription Pro" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer/Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16">
            <materialDesign:ColorZone.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.3"/>
            </materialDesign:ColorZone.Effect>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                     <materialDesign:PackIcon Kind="Microphone" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="Studio Transcription IA"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/> <!-- Tools -->
                <ColumnDefinition Width="24"/>  <!-- Spacer -->
                <ColumnDefinition Width="*"/>   <!-- Result -->
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Tools -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <StackPanel>
                    <!-- Source Selection -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Source Média" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16"/>
                            
                            <!-- File Upload -->
                            <Button Command="{Binding PickFileCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="50" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Upload" Margin="0,0,8,0"/>
                                    <TextBlock Text="Choisir Fichier Audio/Vidéo"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="mp3, wav, mp4, mov, mkv..." FontSize="11" Foreground="{DynamicResource MaterialDesignBodySecondary}" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                            <Separator Margin="0,0,0,16"/>

                            <!-- YouTube -->
                            <TextBox Text="{Binding YoutubeUrl, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Coller URL YouTube ici"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                            
                            <Button Command="{Binding DownloadYoutubeCommand}" Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Youtube" Margin="0,0,8,0"/>
                                    <TextBlock Text="Importer YouTube"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Settings -->
                    <materialDesign:Card Padding="16" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Gestionnaire de Modèles Whisper" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AvailableModels}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="Green" 
                                                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodySecondary}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Download Button -->
                                                    <Button IsEnabled="{Binding IsDownloaded, Converter={StaticResource InverseBooleanConverter}}"
                                                            Command="{Binding DataContext.DownloadModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource MaterialDesignIconForegroundButton}"
                                                            Visibility="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"
                                                            ToolTip="Télécharger ce modèle">
                                                        <materialDesign:PackIcon Kind="Download"/>
                                                    </Button>
                                                    
                                                    <!-- Downloading Status -->
                                                    <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" 
                                                                Value="{Binding DownloadProgress}" 
                                                                IsIndeterminate="False" 
                                                                Width="20" Height="20"
                                                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}"
                                      materialDesign:HintAssist.Hint="Modèle Actif"
                                      DisplayMemberPath="Name"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16"/>
                            
                            <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                                      materialDesign:HintAssist.Hint="Langue Source"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="💡 LargeV3 recommandé pour une qualité maximale." FontSize="11" Foreground="{DynamicResource MaterialDesignBodySecondary}" Margin="0,0,0,16"/>
                            
                            <!-- Multi-language Translation -->
                            <Separator Margin="0,0,0,16"/>
                            <TextBlock Text="Traduction Multi-langues" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ToggleButton IsChecked="{Binding EnableTranslation}" Style="{DynamicResource MaterialDesignSwitchToggleButton}" Margin="0,0,8,0"/>
                                <TextBlock Text="Activer la traduction" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ComboBox ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding SelectedTargetLanguage}"
                                      materialDesign:HintAssist.Hint="Langue Cible"
                                      IsEnabled="{Binding EnableTranslation}"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16"/>
                            
                            <CheckBox Content="Afficher les timestamps" IsChecked="{Binding ShowTimestamps}" Margin="0,0,0,16"/>
                            
                            <!-- Export Buttons -->
                            <TextBlock Text="Exporter" FontWeight="SemiBold" Margin="0,8,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding ExportSrtCommand}" Content="SRT" 
                                        Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                        Margin="0,0,8,0" Padding="12,4"
                                        ToolTip="SubRip - Format standard compatible avec la majorité des lecteurs vidéo"/>
                                <Button Command="{Binding ExportVttCommand}" Content="VTT" 
                                        Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                        Padding="12,4"
                                        ToolTip="WebVTT - Format optimisé pour le web et les navigateurs"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel: Transcription Result -->
            <materialDesign:Card Grid.Column="2" Padding="0" UniformCornerRadius="8" Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="16">
                        <DockPanel>
                            <TextBlock Text="Transcription" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" VerticalAlignment="Center"/>
                            <Button Command="{Binding CopyTextCommand}" Style="{DynamicResource MaterialDesignIconForegroundButton}" DockPanel.Dock="Right" ToolTip="Copier">
                                <materialDesign:PackIcon Kind="ContentCopy"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <TextBox Grid.Row="1" Text="{Binding TranscriptionText}" 
                             Style="{DynamicResource MaterialDesignFilledTextBox}"
                             VerticalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="16"
                             BorderThickness="0" Background="Transparent"
                             IsReadOnly="True"/>
                    
                    <!-- Loading Overlay -->
                    <Grid Grid.RowSpan="3" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="50" Height="50" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="10" Width="200" Margin="0,16,0,0"/>
                            
                            <!-- Stop Button -->
                            <Button Command="{Binding StopCommand}" 
                                    Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                    Foreground="White" BorderBrush="White"
                                    Margin="0,24,0,0" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Stop" Margin="0,0,8,0"/>
                                    <TextBlock Text="Arrêter"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Status Bar with GPU Info -->
        <StatusBar Grid.Row="2" Background="{DynamicResource MaterialDesignDivider}" Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding BackendInfo}" Foreground="#673AB7" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="10" Value="{Binding ProgressValue}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
