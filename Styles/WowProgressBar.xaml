<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Ease In Out Quadratic Easing Function -->
    <QuadraticEase x:Key="EaseInOutQuad" EasingMode="EaseInOut"/>
    <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut"/>
    
    <!-- WOW Premium Progress Bar Style -->
    <Style x:Key="WowProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1A2E" Offset="0"/>
                    <GradientStop Color="#16213E" Offset="0.5"/>
                    <GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6B6B" Offset="0"/>
                    <GradientStop Color="#FFD93D" Offset="0.25"/>
                    <GradientStop Color="#6BCB77" Offset="0.5"/>
                    <GradientStop Color="#4D96FF" Offset="0.75"/>
                    <GradientStop Color="#9D4EDD" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <!-- Background Track with subtle glow -->
                        <Border x:Name="PART_Track" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Opacity="0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F3460" 
                                                  BlurRadius="8" 
                                                  ShadowDepth="0" 
                                                  Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        
                        <!-- Main Animated Progress Indicator -->
                        <Border x:Name="PART_Indicator" 
                                HorizontalAlignment="Left"
                                CornerRadius="6"
                                Background="{TemplateBinding Foreground}">
                            <Border.Effect>
                                <DropShadowEffect Color="#9D4EDD" 
                                                  BlurRadius="20" 
                                                  ShadowDepth="0" 
                                                  Opacity="0.9"/>
                            </Border.Effect>
                            
                            <!-- Inner shine overlay -->
                            <Grid>
                                <Border CornerRadius="6" Opacity="0.4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="0.5"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                
                                <!-- Animated Moving Shine -->
                                <Rectangle x:Name="ShineEffect" Width="80" Height="12" HorizontalAlignment="Left" Opacity="0.6">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#AAFFFFFF" Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="-80"/>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Rectangle.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.X)"
                                                                     From="-80" To="800" Duration="0:0:2.5"
                                                                     EasingFunction="{StaticResource EaseInOutQuad}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </Grid>
                            
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            
                            <Border.Triggers>
                                <!-- Pulse Animation -->
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Pulsing glow effect -->
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             From="1.0" To="1.15" Duration="0:0:1.2"
                                                             AutoReverse="True"
                                                             EasingFunction="{StaticResource EaseInOutCubic}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
